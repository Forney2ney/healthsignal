# HealthSignal backend configuration -- copy to .env and edit. NEVER commit .env.
# Security note: HS_SECRET_KEY defaults to a development-only value when unset;
# set a long random value for any non-local deployment.

HS_SECRET_KEY=change-me-to-a-long-random-string
HS_TOKEN_EXPIRE_MINUTES=720

# SQLite by default (local prototype). PostgreSQL example:
# HS_DATABASE_URL=postgresql+psycopg://user:pass@localhost/healthsignal
HS_DATABASE_URL=sqlite:///./healthsignal.sqlite3

HS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HS_MAX_UPLOAD_MB=10
HS_MODEL_DIR=../ml/artifacts